generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  /// Signature manuscrite scannée, fond transparent de préférence.
  ///
  /// Apposée sur les documents que cette personne vise — VISA DIRECTION et
  /// VISA COMPTABILITÉ sur un bon de décaissement. Stockée, jamais dessinée :
  /// une signature générée n'engage personne.
  signatureUrl            String?
  passwordHash            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  recordedAbsences        Absence[]
  accounts                Account[]
  auditLogs               AuditLog[]
  generatedReports        ClientQuarterlyReport[]
  dashboards              DashboardView[]
  uploadedDocuments       EmployeeDocument[]       @relation("DocumentUploader")
  verifiedDocuments       EmployeeDocument[]       @relation("DocumentVerifier")
  approvedTransfers       EmployeeTransfer[]       @relation("TransferApprover")
  requestedTransfers      EmployeeTransfer[]       @relation("TransferRequester")
  employees               Employee[]
  reviewedLeaves          LeaveRequest[]
  approvedMissions        Mission[]
  approvedPayslips        Payslip[]
  sessions                Session[]
  clientAssignments       UserClientAssignment[]
  userFirms               UserFirm[]
  ipmContributions        IpmMemberContribution[]  @relation("IpmContributionAuthor")
  ipmCards                IpmMemberCard[]          @relation("IpmCardAuthor")
  ipmVouchersIssued       IpmVoucher[]             @relation("IpmVoucherIssuer")
  ipmVouchersSettled      IpmVoucher[]             @relation("IpmVoucherSettler")
  ipmLedgerEntries        IpmLedgerEntry[]         @relation("IpmLedgerAuthor")
  ipmInvoiceStatuses      IpmEmployerInvoice[]     @relation("IpmInvoiceStatusAuthor")
  ipmInvoicesChecked      IpmProviderInvoice[]     @relation("IpmProviderInvoiceChecker")
  ipmReimbReviewed        IpmReimbursement[]       @relation("IpmReimbursementReviewer")
  ipmDisbEntered          IpmDisbursement[]        @relation("IpmDisbursementAuthor")
  ipmDisbApproved         IpmDisbursement[]        @relation("IpmDisbursementApprover")
  ipmDisbAccounting       IpmDisbursement[]        @relation("IpmDisbursementAccountant")
  ipmVouchersReviewed     IpmVoucher[]             @relation("IpmVoucherReviewer")
  ipmCeilingsAuthored     IpmMemberCeiling[]       @relation("IpmMemberCeilingAuthor")
  ipmVouchersValidated    IpmVoucher[]             @relation("IpmVoucherValidator")
  ipmAmountChanges        IpmVoucherAmountChange[] @relation("IpmAmountChangeAuthor")
  providerAccountsCreated ProviderAccount[]        @relation("ProviderAccountCreator")

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Holding {
  id            String         @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  firms         Firm[]
  persons       Person[]
  organizations Organization[]

  @@map("holdings")
}

model Firm {
  id                    String                  @id @default(cuid())
  holdingId             String
  name                  String
  slug                  String                  @unique
  themeColor            String?
  /// En-tête imprimé sur les documents de la filiale.
  ///
  /// Une image, pas un gabarit de champs : la raison sociale, le NINEA,
  /// l'adresse et les téléphones sont déjà composés dedans par la filiale, ce
  /// qui évite d'ajouter cinq colonnes que seule l'impression lirait.
  letterhead            String?
  /// Cachet / tampon apposé au bas des documents signés.
  stamp                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  logo                  String?
  auditLogs             AuditLog[]
  clientAssignments     ClientFirmAssignment[]
  clientReports         ClientQuarterlyReport[]
  clients               Client[]
  clientFirmContracts   Contract[]              @relation("ClientFirmContracts")
  contracts             Contract[]
  dashboards            DashboardView[]
  departments           Department[]
  transfersOut          EmployeeTransfer[]      @relation("TransfersOut")
  transfersIn           EmployeeTransfer[]      @relation("TransfersIn")
  employees             Employee[]
  firmModules           FirmModule[]
  holding               Holding                 @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  leaveRequests         LeaveRequest[]
  missions              Mission[]
  payrollConfig         PayrollConfig?
  payslips              Payslip[]
  userClientAssignments UserClientAssignment[]
  userFirms             UserFirm[]

  // IPM. Every row is firm-scoped, which is what §7 relies on: the tenancy
  // predicate on these tables is the same one every other resolver applies.
  ipmServiceCategories    IpmServiceCategory[]
  ipmServiceTypes         IpmServiceType[]
  ipmProviderSpecialties  IpmProviderSpecialty[]
  ipmMedicalActs          IpmMedicalAct[]
  ipmPlans                IpmPlan[]
  ipmPlanRates            IpmPlanRate[]
  ipmEmployerRates        IpmEmployerRate[]
  ipmEmployers            IpmEmployer[]
  ipmMembers              Member[]
  ipmDependents           Dependent[]
  ipmContributions        IpmMemberContribution[]
  ipmCards                IpmMemberCard[]
  ipmProviders            IpmProvider[]
  ipmProviderBranches     IpmProviderBranch[]
  ipmAgreements           IpmAgreement[]
  ipmVouchers             IpmVoucher[]
  ipmVoucherLines         IpmVoucherLine[]
  ipmConsumptions         IpmConsumption[]
  ipmSequences            IpmSequence[]
  ipmLedgerEntries        IpmLedgerEntry[]
  ipmEmployerInvoices     IpmEmployerInvoice[]
  ipmInvoiceLines         IpmEmployerInvoiceLine[]
  ipmProviderInvoices     IpmProviderInvoice[]
  ipmProviderInvoiceLines IpmProviderInvoiceLine[]
  ipmReimbursements       IpmReimbursement[]
  ipmDisbursements        IpmDisbursement[]
  ipmDisbursementLines    IpmDisbursementLine[]
  // Portail participant.
  portalAccounts          PortalAccount[]
  ipmPortalSettings       IpmPortalSettings?
  portalNotifications     PortalNotification[]
  ipmPortalBookings       IpmPortalBooking[]
  ipmMemberCeilings       IpmMemberCeiling[]
  // Bon de pharmacie à montant différé, et l'accès prestataire.
  ipmVoucherAmountChanges IpmVoucherAmountChange[]
  providerAccounts        ProviderAccount[]

  @@map("firms")
}

model UserFirm {
  id        String   @id @default(cuid())
  userId    String
  firmId    String
  role      FirmRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, firmId])
  @@map("user_firms")
}

model Module {
  id           String             @id @default(cuid())
  slug         String             @unique
  name         String
  description  String?
  version      String
  icon         String?
  basePath     String
  isSystem     Boolean            @default(false)
  isActive     Boolean            @default(true)
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  firmModules  FirmModule[]
  requiredBy   ModuleDependency[] @relation("RequiredBy")
  dependencies ModuleDependency[] @relation("ModuleDeps")

  @@map("modules")
}

model FirmModule {
  id          String   @id @default(cuid())
  firmId      String
  moduleId    String
  isEnabled   Boolean  @default(true)
  settings    Json?
  installedAt DateTime @default(now())
  installedBy String?
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([firmId, moduleId])
  @@map("firm_modules")
}

model ModuleDependency {
  id          String @id @default(cuid())
  moduleId    String
  dependsOnId String
  dependsOn   Module @relation("RequiredBy", fields: [dependsOnId], references: [id], onDelete: Cascade)
  module      Module @relation("ModuleDeps", fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, dependsOnId])
  @@map("module_dependencies")
}

model Department {
  id        String     @id @default(cuid())
  firmId    String
  name      String
  code      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  managerId String?
  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[] @relation("DepartmentEmployees")

  @@unique([firmId, code])
  @@map("departments")
}

model Employee {
  id                 String             @id @default(cuid())
  firmId             String
  userId             String?
  firstName          String
  lastName           String
  matricule          String
  departmentId       String?
  status             EmployeeStatus     @default(ACTIVE)
  hireDate           DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  address            String?
  assignedClientId   String?
  email              String?
  emergencyContact   Json?
  phone              String?
  category           String?
  cni                String?
  contractEndDate    DateTime?
  dateOfBirth        DateTime?
  fatherName         String?
  gender             Gender?
  jobTitle           String?
  maritalStatus      String?
  motherName         String?
  nationality        String?
  netSalary          Decimal?           @db.Decimal(10, 2)
  photoUrl           String?
  placeOfBirth       String?
  /// Shared identity (§4.1). Nullable: this is a link, not the Employment
  /// split — no HR query reads it yet, and rows predating the seed have none.
  personId           String?
  absences           Absence[]
  contracts          Contract[]
  managedDepartments Department[]       @relation("DepartmentManager")
  documents          EmployeeDocument[]
  salaries           EmployeeSalary[]
  transfersOut       EmployeeTransfer[] @relation("TransferFrom")
  assignedClient     Client?            @relation(fields: [assignedClientId], references: [id])
  department         Department?        @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  firm               Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id])
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  requestedMissions  Mission[]
  payslips           Payslip[]
  person             Person?            @relation(fields: [personId], references: [id])
  ipmMembers         Member[]

  @@unique([firmId, matricule])
  @@index([personId])
  @@map("employees")
}

model Contract {
  id                 String            @id @default(cuid())
  firmId             String
  employeeId         String
  type               ContractType
  startDate          DateTime
  endDate            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  alertThreshold     Int               @default(30)
  clientId           String?
  isActive           Boolean           @default(true)
  isAutoRenewal      Boolean           @default(false)
  notes              String?
  position           String?
  renewalDate        DateTime?
  salary             Decimal?          @db.Decimal(10, 2)
  terminationDate    DateTime?
  terminationReason  String?
  trialPeriodEnd     DateTime?
  workingHours       Int?
  clientFirmId       String?
  renewedFromId      String?
  status             ContractStatus    @default(ACTIVE)
  isVise             Boolean           @default(false)
  contractDocumentId String?
  clientFirm         Firm?             @relation("ClientFirmContracts", fields: [clientFirmId], references: [id])
  client             Client?           @relation(fields: [clientId], references: [id])
  contractDocument   EmployeeDocument? @relation("ContractSignedDocument", fields: [contractDocumentId], references: [id])
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  firm               Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  renewedFrom        Contract?         @relation("ContractRenewal", fields: [renewedFromId], references: [id])
  renewals           Contract[]        @relation("ContractRenewal")

  @@index([contractDocumentId])
  @@map("contracts")
}

model EmployeeTransfer {
  id              String         @id @default(cuid())
  employeeId      String
  fromFirmId      String
  toFirmId        String
  clientId        String?
  transferDate    DateTime
  effectiveDate   DateTime
  reason          String
  status          TransferStatus @default(PENDING)
  requestedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  newMatricule    String?
  approver        User?          @relation("TransferApprover", fields: [approvedBy], references: [id])
  client          Client?        @relation(fields: [clientId], references: [id])
  employee        Employee       @relation("TransferFrom", fields: [employeeId], references: [id])
  fromFirm        Firm           @relation("TransfersOut", fields: [fromFirmId], references: [id])
  requester       User           @relation("TransferRequester", fields: [requestedBy], references: [id])
  toFirm          Firm           @relation("TransfersIn", fields: [toFirmId], references: [id])

  @@map("employee_transfers")
}

model LeaveRequest {
  id              String      @id @default(cuid())
  firmId          String
  employeeId      String
  startDate       DateTime
  endDate         DateTime
  status          LeaveStatus @default(PENDING)
  reason          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isJustified     Boolean     @default(false)
  isPaid          Boolean     @default(true)
  justification   String?
  leaveType       LeaveType
  rejectionReason String?
  requestedAt     DateTime    @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  supportingDoc   String?
  totalDays       Decimal     @db.Decimal(5, 2)
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  firm            Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  reviewer        User?       @relation(fields: [reviewedBy], references: [id])

  @@map("leave_requests")
}

model LeaveBalance {
  id            String    @id @default(cuid())
  employeeId    String
  year          Int
  leaveType     LeaveType
  totalDays     Decimal   @db.Decimal(5, 2)
  usedDays      Decimal   @default(0) @db.Decimal(5, 2)
  remainingDays Decimal   @db.Decimal(5, 2)
  carriedOver   Decimal   @default(0) @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, leaveType])
  @@map("leave_balances")
}

model Absence {
  id            String      @id @default(cuid())
  employeeId    String
  firmId        String
  absenceType   AbsenceType
  date          DateTime
  startTime     DateTime?
  endTime       DateTime?
  hours         Decimal?    @db.Decimal(5, 2)
  isJustified   Boolean     @default(false)
  justification String?
  supportingDoc String?
  recordedBy    String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recorder      User        @relation(fields: [recordedBy], references: [id])

  @@map("absences")
}

model Mission {
  id              String           @id @default(cuid())
  firmId          String
  requesterId     String
  title           String
  destination     String
  startDate       DateTime
  endDate         DateTime
  status          MissionStatus    @default(DRAFT)
  purpose         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  actualAmount    Decimal?         @db.Decimal(10, 2)
  approvedAt      DateTime?
  approvedBy      String?
  budgetAmount    Decimal?         @db.Decimal(10, 2)
  completedAt     DateTime?
  missionFees     Decimal?         @db.Decimal(10, 2)
  rejectionReason String?
  report          String?
  expenses        MissionExpense[]
  approver        User?            @relation(fields: [approvedBy], references: [id])
  firm            Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  requester       Employee         @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("missions")
}

model MissionExpense {
  id          String          @id @default(cuid())
  missionId   String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  description String?
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  mission     Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("mission_expenses")
}

model PayrollConfig {
  id        String   @id @default(cuid())
  firmId    String   @unique
  constants Json
  formulas  Json?
  currency  String   @default("XOF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("payroll_configs")
}

model EmployeeSalary {
  id            String    @id @default(cuid())
  employeeId    String
  baseSalary    Decimal   @db.Decimal(10, 2)
  variables     Json?
  effectiveDate DateTime
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslips      Payslip[]

  @@map("employee_salaries")
}

model Payslip {
  id              String         @id @default(cuid())
  firmId          String
  employeeId      String
  salaryId        String
  period          String
  grossSalary     Decimal        @db.Decimal(10, 2)
  netSalary       Decimal        @db.Decimal(10, 2)
  deductions      Json
  additions       Json
  calculationData Json
  status          PayslipStatus  @default(DRAFT)
  generatedAt     DateTime       @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approver        User?          @relation(fields: [approvedBy], references: [id])
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  firm            Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  salary          EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
  @@map("payslips")
}

model Client {
  id                String                  @id @default(cuid())
  firmId            String
  name              String
  contactName       String?
  taxNumber         String?
  address           String?
  tags              String[]
  status            ClientStatus            @default(PROSPECT)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  contactEmail      String?
  contactPhone      String?
  contractEndDate   DateTime?
  contractStartDate DateTime?
  industry          String?
  notes             String?
  photoUrl          String?
  /// Shared identity (§4.1). A client and an IPM employer can be the same
  /// company; nullable because no CRM query reads it yet.
  organizationId    String?
  firmAssignments   ClientFirmAssignment[]
  quarterlyReports  ClientQuarterlyReport[]
  firm              Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  contracts         Contract[]
  transfers         EmployeeTransfer[]
  assignedEmployees Employee[]
  userAssignments   UserClientAssignment[]
  organization      Organization?           @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("clients")
}

model UserClientAssignment {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  firmId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId, firmId])
  @@map("user_client_assignments")
}

model ClientFirmAssignment {
  id        String    @id @default(cuid())
  clientId  String
  firmId    String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm      Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([clientId, firmId])
  @@map("client_firm_assignments")
}

model ClientQuarterlyReport {
  id            String    @id @default(cuid())
  firmId        String
  clientId      String
  quarter       String
  year          Int
  quarterNumber Int
  employeeCount Int
  totalHours    Decimal?  @db.Decimal(10, 2)
  totalCost     Decimal?  @db.Decimal(10, 2)
  reportData    Json
  generatedAt   DateTime  @default(now())
  generatedBy   String
  pdfUrl        String?
  excelUrl      String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm          Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  generator     User      @relation(fields: [generatedBy], references: [id])

  @@unique([clientId, quarter])
  @@map("client_quarterly_reports")
}

model EmployeeDocument {
  id              String       @id @default(cuid())
  employeeId      String
  firmId          String
  documentType    DocumentType
  fileName        String
  storageKey      String
  fileUrl         String?
  fileSize        Int?
  mimeType        String?
  uploadedBy      String
  description     String?
  expiryDate      DateTime?
  isVerified      Boolean      @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  metadata        Json?
  tags            String[]     @default([])
  signedContracts Contract[]   @relation("ContractSignedDocument")
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploader        User         @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  verifier        User?        @relation("DocumentVerifier", fields: [verifiedBy], references: [id])

  @@map("employee_documents")
}

model DashboardView {
  id        String   @id @default(cuid())
  firmId    String
  userId    String
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboard_views")
}

model AuditLog {
  id        String   @id @default(cuid())
  firmId    String?
  actorId   String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  firm      Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

enum FirmRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
  RESPONSABLE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  ON_LEAVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractType {
  CDI
  CDD
  STAGE
  PRESTATION
  INTERIM
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  SPECIAL
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AbsenceType {
  UNJUSTIFIED
  JUSTIFIED
  LATE_ARRIVAL
  EARLY_DEPARTURE
}

enum MissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  IN_PROGRESS
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  MEALS
  FUEL
  OTHER
}

