// ============================================================================
// SHARED IDENTITY — HOLDING LEVEL
// ============================================================================
// Plan §4.1. A person may be simultaneously an employee of Connect Interim and
// an IPM participant; a company may be a CRM client, an employer of interims
// and an IPM employer. Identity therefore lives above the firm, and the
// firm-scoped records point at it.
//
// This does **not** rewrite Employee or Client onto Person/Organization — that
// is the Employment split the plan lists as Phase 0 socle, and it touches every
// HR query. The links below are nullable so identity can be established
// incrementally; the IPM side uses them as the source of truth from day one.

model Person {
  id         String    @id @default(cuid())
  holdingId  String
  firstName  String
  lastName   String
  birthDate  DateTime?
  birthPlace String?
  gender     Gender?
  /// CNI sénégalaise.
  nationalId String?
  passportNo String?
  phone      String?
  email      String?
  address    String?
  /// Zipline URL, same convention as Employee.photoUrl.
  photoUrl   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  holding    Holding     @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  employees  Employee[]
  members    Member[]
  dependents Dependent[]

  // Postgres treats NULLs as distinct, so people without a CNI do not collide.
  @@unique([holdingId, nationalId])
  @@index([holdingId, lastName, firstName])
  @@map("persons")
}

model Organization {
  id        String   @id @default(cuid())
  holdingId String
  /// Raison sociale.
  name      String
  ninea     String?
  sector    String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holding   Holding       @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  clients   Client[]
  employers IpmEmployer[]
  providers IpmProvider[]

  @@unique([holdingId, ninea])
  @@index([holdingId, name])
  @@map("organizations")
}

// ============================================================================
// IPM — RÉFÉRENTIELS
// ============================================================================

/// Catégorie de soins. A **table, not an enum** (§11 Q3).
///
/// Asked whether accouchement should be priced separately, the answer was that
/// plan options must stay configurable — so categories, rates, ceilings and
/// waiting periods are data an administrator edits, never an enum that needs a
/// deploy. Adding MATERNITE is a row, not a migration.
model IpmServiceCategory {
  id        String   @id @default(cuid())
  firmId    String
  code      String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm              Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  serviceTypes      IpmServiceType[]
  planRates         IpmPlanRate[]
  employerRates     IpmEmployerRate[]
  vouchers          IpmVoucher[]
  consumptions      IpmConsumption[]
  ledgerEntries     IpmLedgerEntry[]
  invoiceLines      IpmEmployerInvoiceLine[]
  /// Cache of the register total. The register is the truth; this is rebuilt.
  currentBalance    Decimal                  @default(0) @db.Decimal(14, 2)
  balanceAsOf       DateTime?
  ipmReimbursements IpmReimbursement[]

  memberCeilings IpmMemberCeiling[]

  @@unique([firmId, code])
  @@map("ipm_service_categories")
}

/// Type de prestation — WebLamps codes 0-49, SYSCOHADA 602xxx.
model IpmServiceType {
  id          String   @id @default(cuid())
  firmId      String
  categoryId  String
  code        String
  label       String
  /// Compte SYSCOHADA 602xxx. Not renumbered — see plan §3.
  accountCode String?
  legacyCode  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm           Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  category       IpmServiceCategory @relation(fields: [categoryId], references: [id])
  medicalActs    IpmMedicalAct[]
  vouchers       IpmVoucher[]
  portalBookings IpmPortalBooking[]

  @@unique([firmId, code])
  @@index([firmId, categoryId])
  @@map("ipm_service_types")
}

/// Spécialité prestataire — codes 0-99, SYSCOHADA 400xxx.
model IpmProviderSpecialty {
  id          String   @id @default(cuid())
  firmId      String
  code        String
  label       String
  accountCode String?
  legacyCode  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm           Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  providers      IpmProvider[]
  portalBookings IpmPortalBooking[]

  @@unique([firmId, code])
  @@map("ipm_provider_specialties")
}

model IpmMedicalAct {
  id            String   @id @default(cuid())
  firmId        String
  serviceTypeId String
  code          String
  label         String
  coefficient   Decimal? @db.Decimal(8, 2)
  tariff        Decimal? @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firm         Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  serviceType  IpmServiceType   @relation(fields: [serviceTypeId], references: [id])
  voucherLines IpmVoucherLine[]

  @@unique([firmId, code])
  @@index([firmId, serviceTypeId])
  @@map("ipm_medical_acts")
}

// ============================================================================
// IPM — FORMULES ET BARÈMES
// ============================================================================

/// Who a rate applies to.
///
/// `ALL` is a real member rather than a nullable column on purpose: a nullable
/// discriminator cannot be covered by a unique constraint in Postgres, where
/// NULLs are distinct — two "applies to everyone" rows for the same category
/// would both be accepted. Resolution tries the exact type, then ALL.
///
/// The numbers are the WebLamps `codebenef` values, kept for the import. The
/// participant carries 1; `lienjuridique` is not used (229 CJ for 95 real
/// spouses — see plan §4.2).
enum IpmBeneficiaryType {
  ALL
  MEMBER // 1
  SPOUSE_F // 2
  CHILD // 3
  SPOUSE_M // 4
  ASCENDANT // 5
  OTHER // 6
}

/// Formule commerciale (Tawfeikh / Xeweul / Teranga / Noflay).
///
/// Effective-dated: a voucher issued in January must still price against
/// January's formule after a March change, so a price is never updated in
/// place. `validTo` NULL means currently in force.
model IpmPlan {
  id           String    @id @default(cuid())
  firmId       String
  code         String
  name         String
  monthlyPrice Decimal   @db.Decimal(12, 2)
  validFrom    DateTime
  validTo      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  firm          Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  rates         IpmPlanRate[]
  employers     IpmEmployer[]
  contributions IpmMemberContribution[]

  @@unique([firmId, code, validFrom])
  @@index([firmId, active])
  @@map("ipm_plans")
}

/// Barème — taux de prise en charge et plafonds.
///
/// `rate` is a fraction, not a percentage: the settlement engine computes
/// `insurerShare = ceil(totalAmount × rate)` directly, and a stray ×100 in that
/// line is the kind of error that is invisible until money moves. The interface
/// renders it as a percentage; the column never holds one.
model IpmPlanRate {
  id                String             @id @default(cuid())
  firmId            String
  planId            String
  categoryId        String
  beneficiaryType   IpmBeneficiaryType @default(ALL)
  rate              Decimal            @db.Decimal(5, 4)
  ceilingPerAct     Decimal?           @db.Decimal(12, 2)
  ceilingMonthly    Decimal?           @db.Decimal(12, 2)
  ceilingAnnual     Decimal?           @db.Decimal(12, 2)
  /// Délai de carence, en jours. Distinct des plafonds (plan §4.3).
  waitingPeriodDays Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  firm     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  plan     IpmPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  category IpmServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([planId, categoryId, beneficiaryType])
  @@map("ipm_plan_rates")
}

/// Dérogation par employeur. Wins over the formule's own barème.
///
/// The 20 current employers apply a single rate (50, 70 or 80%) and are
/// migrated here, then moved onto a formule when the IPM decides.
model IpmEmployerRate {
  id                String             @id @default(cuid())
  firmId            String
  employerId        String
  categoryId        String
  beneficiaryType   IpmBeneficiaryType @default(ALL)
  rate              Decimal            @db.Decimal(5, 4)
  ceilingPerAct     Decimal?           @db.Decimal(12, 2)
  ceilingMonthly    Decimal?           @db.Decimal(12, 2)
  ceilingAnnual     Decimal?           @db.Decimal(12, 2)
  waitingPeriodDays Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  firm     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  employer IpmEmployer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category IpmServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([employerId, categoryId, beneficiaryType])
  @@map("ipm_employer_rates")
}

// ============================================================================
// IPM — AFFILIATION
// ============================================================================

enum IpmEmployerStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum IpmMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum IpmDependentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// Ayant droit. WebLamps `codebenef`; `lienjuridique` is deliberately ignored.
enum IpmDependentRelation {
  SPOUSE_F // 2
  CHILD // 3
  SPOUSE_M // 4
  ASCENDANT // 5
  OTHER // 6
}

model IpmEmployer {
  id                 String            @id @default(cuid())
  firmId             String
  organizationId     String
  legacyCode         String?
  /// The `001` of a WebLamps `001-00185-21`. Kept so a legacy matricule can be
  /// rebuilt and reconciled; it does not number anything new.
  legacyEmployerCode String?
  /// Optional prefix for generated member matricules.
  ///
  /// NULL — the normal case — puts the employer's members on the firm-wide
  /// five-digit sequence the cards carry (`01716`, §11 Q1). A prefix exists
  /// only for an employer that later wants a series of its own, and is not
  /// unique: several employers sharing the card sequence all have none.
  matriculePrefix    String?
  planId             String?
  /// Compte SYSCOHADA 463xxx. Two legacy formats, normalised on import.
  accountCode        String?
  affiliationDate    DateTime
  terminationDate    DateTime?
  status             IpmEmployerStatus @default(ACTIVE)

  /// Âge auquel un enfant cesse d'être couvert. 21 ou 22 selon l'employeur.
  ageMajority   Int @default(21)
  ageRetirement Int @default(60)

  /// Defaults inherited by a new member's first contribution row.
  contributionEmployerAmount Decimal? @db.Decimal(12, 2)
  contributionEmployeeAmount Decimal? @db.Decimal(12, 2)
  contributionRate           Decimal? @db.Decimal(5, 4)

  reminderDelayDays   Int      @default(15)
  suspensionDelayDays Int      @default(90)
  /// `seuil_conso` 1e8–1e12 in the legacy data is imported as NULL = illimité.
  consumptionCeiling  Decimal? @db.Decimal(14, 2)
  debtCeiling         Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm         Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id])
  plan         IpmPlan?             @relation(fields: [planId], references: [id])
  members      Member[]
  rates        IpmEmployerRate[]
  invoices     IpmEmployerInvoice[]

  @@unique([firmId, organizationId])
  @@unique([firmId, legacyEmployerCode])
  @@unique([firmId, legacyCode])
  @@index([firmId, status])
  @@map("ipm_employers")
}

model Member {
  id         String  @id @default(cuid())
  firmId     String
  personId   String
  employerId String
  /// Link to the employment that drives the affiliation (§7). Nullable: the IPM
  /// also covers employers outside the group, who have no Employee row here.
  employeeId String?

  /// Canonical matricule — the short form printed on the cards (`01716`).
  /// §11 Q1. `legacyCode` keeps the WebLamps `001-00185-21` so the two forms
  /// stay cross-referenceable at the counter.
  matricule  String
  legacyCode String?

  jobTitle        String?
  affiliationDate DateTime
  terminationDate DateTime?
  status          IpmMemberStatus @default(PENDING)

  /// Cache of the register total (§4.8bis). The register is the source of
  /// truth; this exists so a list of 265 participants does not fold 265
  /// histories, and `recomputeBalances` rebuilds it from the entries.
  currentBalance Decimal   @default(0) @db.Decimal(14, 2)
  balanceAsOf    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm           Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  person         Person                   @relation(fields: [personId], references: [id])
  employer       IpmEmployer              @relation(fields: [employerId], references: [id])
  employee       Employee?                @relation(fields: [employeeId], references: [id])
  dependents     Dependent[]
  contributions  IpmMemberContribution[]
  card           IpmMemberCard?
  vouchers       IpmVoucher[]
  consumptions   IpmConsumption[]
  ledgerEntries  IpmLedgerEntry[]
  invoiceLines   IpmEmployerInvoiceLine[]
  reimbursements IpmReimbursement[]
  portalAccount  PortalAccount?
  ceilings       IpmMemberCeiling[]

  @@unique([firmId, matricule])
  @@unique([firmId, legacyCode])
  @@index([firmId, employerId, status])
  @@index([firmId, personId])
  @@map("ipm_members")
}

model Dependent {
  id       String @id @default(cuid())
  firmId   String
  memberId String
  personId String

  matricule    String
  legacyCode   String?
  relation     IpmDependentRelation
  /// Position within the member's family, 1-based. Drives the card's verso.
  rank         Int
  marriageDate DateTime?

  coverageStart DateTime
  coverageEnd   DateTime?
  status        IpmDependentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm              Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member            Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  person            Person             @relation(fields: [personId], references: [id])
  vouchers          IpmVoucher[]
  ipmReimbursements IpmReimbursement[]

  @@unique([firmId, matricule])
  @@unique([memberId, rank])
  @@index([firmId, memberId, status])
  @@map("ipm_dependents")
}

/// Cotisation du participant — effective-dated rows, never a mutable column.
///
/// §11 Q6: the contribution is a fixed amount, and an upgrade must not lose the
/// previous one. A single `monthlyContribution` column cannot satisfy both — an
/// UPDATE erases exactly the history being asked for — so each change closes the
/// current row and opens a new one. A January voucher prices against January's
/// amount even after a March upgrade.
///
/// §11 Q12: one contribution per family. The amount covers the participant and
/// their ayants droit, not one per covered head.
///
/// `validTo` NULL means currently in force; exactly one such row per member.
model IpmMemberContribution {
  id       String  @id @default(cuid())
  firmId   String
  memberId String
  /// The formule this amount was priced against, when there is one.
  planId   String?

  monthlyAmount  Decimal  @db.Decimal(12, 2)
  employerAmount Decimal? @db.Decimal(12, 2)
  employeeAmount Decimal? @db.Decimal(12, 2)

  validFrom DateTime
  validTo   DateTime?
  /// Why it changed — an upgrade, a correction, a renegotiation.
  reason    String?

  createdAt   DateTime @default(now())
  createdById String?

  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan      IpmPlan? @relation(fields: [planId], references: [id])
  createdBy User?    @relation("IpmContributionAuthor", fields: [createdById], references: [id])

  @@index([firmId, memberId, validFrom])
  @@map("ipm_member_contributions")
}

/// Carte de tiers payant — plan §4.10 et §6.
///
/// The row records *that* a card exists and what it was generated from; the
/// image itself is rendered on demand through an authenticated route rather
/// than stored. Storing the bytes buys nothing while a card can be redrawn in
/// milliseconds, and it would immediately create the problem the plan warns
/// about elsewhere: a file on disk that no longer matches the data.
///
/// `inputsHash` is what makes staleness computable. It digests exactly the
/// fields printed on the card, so adding an ayant droit, correcting a name,
/// changing a formule or a child reaching majority all change it — and the
/// dashboard can count cards whose hash no longer matches without rendering
/// anything.
///
/// `revokedAt` is radiation: the card stops verifying, and the row stays as
/// the record that it once did.
model IpmMemberCard {
  id            String    @id @default(cuid())
  firmId        String
  memberId      String
  /// Incremented on every regeneration, and printed on the card.
  version       Int       @default(1)
  inputsHash    String
  ppi           Int       @default(300)
  generatedAt   DateTime  @default(now())
  generatedById String?
  revokedAt     DateTime?

  firm        Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  generatedBy User?  @relation("IpmCardAuthor", fields: [generatedById], references: [id])

  @@unique([memberId])
  @@index([firmId, inputsHash])
  @@map("ipm_member_cards")
}

// ============================================================================
// IPM — PRESTATAIRES ET CONVENTIONS
// ============================================================================

enum IpmProviderStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum IpmAgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

/// Prestataire de soins — pharmacie, clinique, cabinet, laboratoire.
///
/// `accredited` is separate from `status` on purpose. A provider can be a
/// live, payable counterparty and still not be agréé for tiers payant; the
/// two answer different questions, and collapsing them is how a voucher gets
/// issued against somebody who never signed a convention.
model IpmProvider {
  id              String            @id @default(cuid())
  firmId          String
  organizationId  String?
  legacyCode      String?
  name            String
  specialtyId     String?
  address         String?
  phone           String?
  email           String?
  /// Compte fournisseur SYSCOHADA 400xxx.
  accountCode     String?
  /// Agréé pour le tiers payant. Distinct from being an active counterparty.
  accredited      Boolean           @default(false)
  status          IpmProviderStatus @default(ACTIVE)
  /// Délai de règlement, en jours. 60 in the current agreements.
  paymentTermDays Int               @default(60)
  bankName        String?
  bankAccount     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm         Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  organization Organization?         @relation(fields: [organizationId], references: [id])
  specialty    IpmProviderSpecialty? @relation(fields: [specialtyId], references: [id])
  branches     IpmProviderBranch[]
  agreements   IpmAgreement[]
  vouchers     IpmVoucher[]
  invoices     IpmProviderInvoice[]
  account      ProviderAccount?

  @@unique([firmId, legacyCode])
  @@index([firmId, status, accredited])
  @@index([firmId, name])
  @@map("ipm_providers")
}

model IpmProviderBranch {
  id         String   @id @default(cuid())
  firmId     String
  providerId String
  name       String
  address    String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  firm     Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  provider IpmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([firmId, providerId])
  @@map("ipm_provider_branches")
}

/// Convention. A new construction, not a migration: the 101 legacy provider
/// records carry no dates and no rates at all (plan §4.5).
model IpmAgreement {
  id             String             @id @default(cuid())
  firmId         String
  providerId     String
  reference      String
  startDate      DateTime
  endDate        DateTime?
  /// Remise négociée sur le tarif affiché, en fraction. Not a prise en charge
  /// rate — that belongs to the formule, and confusing the two would apply a
  /// provider discount as if it were the institution's share.
  negotiatedRate Decimal?           @db.Decimal(5, 4)
  terms          String?
  status         IpmAgreementStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm     Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  provider IpmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([firmId, reference])
  @@index([firmId, providerId, status])
  @@map("ipm_agreements")
}

// ============================================================================
// IPM — BONS DE PRISE EN CHARGE
// ============================================================================

/// The four legacy document families: BPI pharmacie, BCI optique,
/// LGI lettre de garantie, LHI lettre d'hospitalisation.
enum IpmVoucherType {
  PHARMACY
  OPTICAL
  GUARANTEE
  HOSPITALIZATION
}

/// Replaces the legacy OK/KO pair, which cannot tell "issued" from "rejected"
/// and leaves the counter guessing (plan §4.6).
enum IpmVoucherStatus {
  /// Bon de pharmacie émis sans montant: the pharmacy only gives a receipt
  /// once paid, so the participant attaches the ordonnance and the pharmacist
  /// enters the amount when they validate. Commits nothing until then — no
  /// consumption, no ledger entry, no invoice line.
  AWAITING_AMOUNT
  /// Portail: above the review threshold (or carrying an issuance warning),
  /// waiting for the gestionnaire. Its share is already reserved.
  PENDING_REVIEW
  ISSUED
  PRESENTED
  SETTLED
  INVOICED
  CANCELLED
  EXPIRED
  /// Portail: refused at review. Distinct from CANCELLED, which is done to a
  /// bon that was valid.
  REJECTED
}

/// Where a bon was created.
enum IpmVoucherOrigin {
  BACKOFFICE
  PORTAL
}

/// How the participant filled a portal bon.
enum IpmVoucherEntryMode {
  SCAN
  MANUAL
}

/// Who entered the amount of a bon de pharmacie à montant différé.
enum IpmVoucherAmountSource {
  /// The bound pharmacy, from its own session.
  PROVIDER
  /// A gestionnaire, on the pharmacy's behalf or as a correction.
  BACK_OFFICE
}

/// What a row of `IpmVoucherAmountChange` records.
enum IpmVoucherAmountChangeKind {
  VALIDATE
  ADJUST
  VOID
}

/// Why a portal bon needs a gestionnaire's look.
enum IpmReviewFlag {
  ABOVE_THRESHOLD
  AMOUNT_UNUSUAL
  SAME_DAY_DUPLICATE
  RECEIPT_REUSED
  OCR_MISMATCH
  /// `decideIssuance` raised a warning. A participant cannot "confirm anyway"
  /// the way an operator can, so the bon waits for someone who can.
  ISSUANCE_WARNING
  /// Bon de pharmacie validated above `pharmacyReviewThreshold`. It still
  /// counts; the flag only asks for a look.
  AMOUNT_ABOVE_THRESHOLD
  /// The IPM share was capped by the remaining plafond at validation.
  CEILING_CAPPED
  /// The same ordonnance file is attached to another live bon.
  PRESCRIPTION_REUSED
}

/// Bon de prise en charge.
///
/// `beneficiaryRef` points at the covered head — the participant themselves or
/// one of their ayants droit — and is what consumption accumulates against.
/// Both are stored: `memberId` is the family the cotisation belongs to,
/// `dependentId` is who actually presented.
model IpmVoucher {
  id     String         @id @default(cuid())
  firmId String
  number String
  type   IpmVoucherType

  memberId        String
  dependentId     String?
  /// Denormalised at issue: the rate a bon was priced at must not move when
  /// somebody later edits a barème (plan §4.3, and the same reason cotisations
  /// are effective-dated).
  beneficiaryType IpmBeneficiaryType
  beneficiaryName String

  providerId    String
  serviceTypeId String
  categoryId    String

  issueDate  DateTime
  expiryDate DateTime
  status     IpmVoucherStatus @default(ISSUED)

  /// Null only on a bon de pharmacie whose amount was never entered
  /// (AWAITING_AMOUNT, or expired / cancelled before it was). Every other bon
  /// carries one — enforced by the domain (`amountRequiredFor`), not only here.
  totalAmount  Decimal? @default(0) @db.Decimal(12, 2)
  insurerShare Decimal  @default(0) @db.Decimal(12, 2)
  memberShare  Decimal  @default(0) @db.Decimal(12, 2)
  /// The resolved taux, frozen. Fraction, never a percentage.
  appliedRate  Decimal  @db.Decimal(5, 4)
  /// Where the rate came from, so a settlement can be explained years later.
  rateSource   String

  /// HMAC token for counter verification. Rotated when the bon is cancelled.
  ///
  /// Not unique: since the token identifies the *bearer* (firm, matricule,
  /// expiry day) rather than the bon, two bons for one participant on one day
  /// carry the same token, and every cancelled bon carries the same dead one.
  /// Nothing looks a bon up by it — /v/ resolves the bearer by matricule.
  qrToken String

  issuedById   String?
  settledAt    DateTime?
  settledById  String?
  cancelledAt  DateTime?
  cancelReason String?

  providerInvoiceId String?

  // Portail participant ------------------------------------------------------
  origin                  IpmVoucherOrigin     @default(BACKOFFICE)
  issuedByPortalAccountId String?
  entryMode               IpmVoucherEntryMode?
  /// Zipline URL. Mandatory for origin = PORTAL (enforced by the API).
  receiptUrl              String?
  /// dHash, 16 hex chars — detects a receipt photo reused for another bon.
  receiptHash             String?
  /// Total read from the receipt, kept to explain OCR_MISMATCH.
  ocrTotal                Decimal?             @db.Decimal(12, 2)
  reviewFlags             IpmReviewFlag[]
  reviewedById            String?
  reviewedAt              DateTime?
  reviewReason            String?
  /// Idempotency key sent by the portal: a retried submission returns the
  /// bon already written instead of issuing a second one.
  clientRequestId         String?

  // Montant différé (bon de pharmacie) ---------------------------------------
  /// Issued without an amount; the pharmacy (or a gestionnaire) enters it.
  /// Stays true after validation: it is what the back-office override acts on.
  deferredAmount               Boolean                 @default(false)
  /// Zipline URL of the ordonnance. Never sent to a client: every reader goes
  /// through an authenticated route that streams the file.
  prescriptionUrl              String?
  /// SHA-256 of the uploaded file, hex.
  prescriptionHash             String?
  amountEnteredAt              DateTime?
  amountSource                 IpmVoucherAmountSource?
  validatedByProviderAccountId String?
  validatedByUserId            String?
  validatedAt                  DateTime?
  /// Idempotency key of the validation that set the amount: a retry with the
  /// same key answers the same split; any other attempt is ALREADY_VALIDATED.
  validationKey                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm                  Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  validatedByProvider   ProviderAccount?         @relation(fields: [validatedByProviderAccountId], references: [id])
  validatedByUser       User?                    @relation("IpmVoucherValidator", fields: [validatedByUserId], references: [id])
  amountChanges         IpmVoucherAmountChange[]
  issuedByPortalAccount PortalAccount?           @relation(fields: [issuedByPortalAccountId], references: [id])
  reviewedBy            User?                    @relation("IpmVoucherReviewer", fields: [reviewedById], references: [id])
  notifications         PortalNotification[]
  member                Member                   @relation(fields: [memberId], references: [id])
  dependent             Dependent?               @relation(fields: [dependentId], references: [id])
  provider              IpmProvider              @relation(fields: [providerId], references: [id])
  serviceType           IpmServiceType           @relation(fields: [serviceTypeId], references: [id])
  category              IpmServiceCategory       @relation(fields: [categoryId], references: [id])
  issuedBy              User?                    @relation("IpmVoucherIssuer", fields: [issuedById], references: [id])
  settledBy             User?                    @relation("IpmVoucherSettler", fields: [settledById], references: [id])
  lines                 IpmVoucherLine[]
  consumption           IpmConsumption[]
  invoiceLines          IpmProviderInvoiceLine[]

  @@unique([firmId, number])
  @@unique([firmId, clientRequestId])
  @@index([firmId, status, issueDate])
  @@index([firmId, memberId])
  @@index([firmId, providerId, status])
  @@index([firmId, receiptHash])
  @@index([firmId, origin, status])
  @@index([firmId, qrToken])
  @@index([firmId, providerId, validatedAt])
  @@index([firmId, prescriptionHash])
  @@map("ipm_vouchers")
}

model IpmVoucherLine {
  id           String   @id @default(cuid())
  firmId       String
  voucherId    String
  medicalActId String?
  label        String
  quantity     Decimal  @default(1) @db.Decimal(8, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  firm       Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  voucher    IpmVoucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  medicalAct IpmMedicalAct? @relation(fields: [medicalActId], references: [id])

  @@index([firmId, voucherId])
  @@map("ipm_voucher_lines")
}

/// Every amount a bon de pharmacie à montant différé has carried, and who set
/// it. Written in the transaction that changes the bon, by the one function
/// that does (`server/ipm/voucher-amount.ts`). The actor is a provider account
/// or a back-office user — exactly one of them — which is why this is not
/// `AuditLog`: that table requires a User.
model IpmVoucherAmountChange {
  id        String                     @id @default(cuid())
  firmId    String
  voucherId String
  kind      IpmVoucherAmountChangeKind

  previousAmount       Decimal? @db.Decimal(12, 2)
  newAmount            Decimal? @db.Decimal(12, 2)
  previousInsurerShare Decimal? @db.Decimal(12, 2)
  newInsurerShare      Decimal? @db.Decimal(12, 2)

  providerAccountId String?
  userId            String?
  /// Mandatory for a back-office change; null for a pharmacy's validation.
  reason            String?
  createdAt         DateTime @default(now())

  firm            Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  voucher         IpmVoucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  providerAccount ProviderAccount? @relation(fields: [providerAccountId], references: [id])
  user            User?            @relation("IpmAmountChangeAuthor", fields: [userId], references: [id])

  @@index([firmId, voucherId, createdAt])
  @@map("ipm_voucher_amount_changes")
}

/// Consommation — plan §4.7.
///
/// Fed by both flows (bons and, from phase 4, remboursements). Without it no
/// plafond is enforceable at the moment of issue, which is the whole reason it
/// exists as a table rather than being derived on demand: the issuance check
/// runs on every bon and cannot afford to sum the history each time.
model IpmConsumption {
  id             String @id @default(cuid())
  firmId         String
  /// The covered head: `member:<id>` or `dependent:<id>`.
  beneficiaryRef String
  memberId       String
  categoryId     String
  periodYear     Int
  periodMonth    Int

  voucherId String?

  amount       Decimal @db.Decimal(12, 2)
  insurerShare Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  firm     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member   Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category IpmServiceCategory @relation(fields: [categoryId], references: [id])
  voucher  IpmVoucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([firmId, beneficiaryRef, categoryId, periodYear])
  @@index([firmId, memberId, periodYear, periodMonth])
  @@map("ipm_consumptions")
}

/// Séquences de numérotation, par type et par exercice.
///
/// A row per (firm, kind, year) whose `next` is advanced inside the issuing
/// transaction. Computing "max + 1" instead is what the HR module did, and two
/// concurrent issues then produce the same number — for a bon, that is a
/// document handed to two different people.
model IpmSequence {
  id     String @id @default(cuid())
  firmId String
  /// `BPI`, `BCI`, `LGI`, `LHI`, `DEC`, `FACT`…
  kind   String
  year   Int
  next   Int    @default(1)

  updatedAt DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, kind, year])
  @@map("ipm_sequences")
}

// ============================================================================
// IPM — REGISTRE PARTICIPANT (PHASE 3)
// ============================================================================

/// Nature d'une écriture au registre — plan §4.8bis.
enum IpmLedgerType {
  /// Solde d'ouverture à la bascule. §11 Q11: the figure is supplied by the
  /// institution, never derived, and a member without one is reported rather
  /// than assumed to start at zero.
  OPENING
  CONTRIBUTION
  CONSUMPTION
  ADJUSTMENT
  REVERSAL
}

enum IpmLedgerSource {
  OPENING
  INVOICE
  VOUCHER
  REIMBURSEMENT
  MANUAL
}

/// Registre participant — **écriture seule**.
///
/// No row is ever modified or deleted. A correction is an ADJUSTMENT or a
/// REVERSAL, which is the only way to get a financial trail anybody can defend
/// and the only way to stop balances changing retroactively with no
/// explanation (plan §4.8bis).
///
/// `balanceAfter` is stored per row so a statement can be read without
/// re-summing the history, and `Member.currentBalance` caches the last one.
/// Both are derived: the sum of the register is the truth, and a recompute
/// command exists precisely because a cache that cannot be rebuilt is a
/// liability.
model IpmLedgerEntry {
  id       String @id @default(cuid())
  firmId   String
  memberId String

  periodYear  Int
  periodMonth Int

  type       IpmLedgerType
  sourceType IpmLedgerSource
  sourceId   String?

  credit       Decimal @default(0) @db.Decimal(14, 2)
  debit        Decimal @default(0) @db.Decimal(14, 2)
  /// Running balance after this entry, in insertion order.
  balanceAfter Decimal @db.Decimal(14, 2)

  note String?

  createdAt   DateTime @default(now())
  createdById String?

  firm                 Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member               Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy            User?               @relation("IpmLedgerAuthor", fields: [createdById], references: [id])
  ipmServiceCategory   IpmServiceCategory? @relation(fields: [ipmServiceCategoryId], references: [id])
  ipmServiceCategoryId String?

  @@index([firmId, memberId, createdAt])
  @@index([firmId, periodYear, periodMonth])
  @@map("ipm_ledger_entries")
}

// ============================================================================
// IPM — FACTURATION EMPLOYEUR (PHASE 3)
// ============================================================================

enum IpmEmployerInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

/// Facture employeur — plan §4.8ter.
///
/// One per employer per month, enforced by the unique constraint: a second
/// closing for the same period is a duplicate, not a correction.
///
/// The status is the user's to change, but every change records who and when
/// and passes through AuditLog. A "paid" with no trace of who entered it has
/// no evidential value, which is the whole point of the field.
model IpmEmployerInvoice {
  id         String @id @default(cuid())
  firmId     String
  employerId String

  number      String
  periodYear  Int
  periodMonth Int

  issueDate DateTime
  dueDate   DateTime

  memberCount   Int
  employerShare Decimal @db.Decimal(14, 2)
  employeeShare Decimal @db.Decimal(14, 2)
  totalAmount   Decimal @db.Decimal(14, 2)

  status IpmEmployerInvoiceStatus @default(DRAFT)

  paidAmount       Decimal   @default(0) @db.Decimal(14, 2)
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?

  statusChangedById String?
  statusChangedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm            Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  employer        IpmEmployer              @relation(fields: [employerId], references: [id])
  statusChangedBy User?                    @relation("IpmInvoiceStatusAuthor", fields: [statusChangedById], references: [id])
  lines           IpmEmployerInvoiceLine[]

  @@unique([employerId, periodYear, periodMonth])
  @@unique([firmId, number])
  @@index([firmId, status, periodYear])
  @@map("ipm_employer_invoices")
}

/// A line per participant, with their name and matricule **copied in**.
///
/// Denormalised on purpose: an invoice is a document that was issued on a
/// date, and it must still read the same after somebody is renamed or radiated.
model IpmEmployerInvoiceLine {
  id        String @id @default(cuid())
  firmId    String
  invoiceId String
  memberId  String

  matricule  String
  memberName String

  monthlyContribution Decimal @db.Decimal(12, 2)
  employerShare       Decimal @db.Decimal(12, 2)
  employeeShare       Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  firm                 Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice              IpmEmployerInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  member               Member              @relation(fields: [memberId], references: [id])
  ipmServiceCategory   IpmServiceCategory? @relation(fields: [ipmServiceCategoryId], references: [id])
  ipmServiceCategoryId String?

  @@index([firmId, invoiceId])
  @@map("ipm_employer_invoice_lines")
}

// ============================================================================
// IPM — DÉCAISSEMENTS (PHASE 4)
// ============================================================================

/// D'où vient une facture prestataire.
///
/// RECEIVED est le cas historique : le prestataire envoie un papier, on le
/// saisit, et le contrôle consiste à rapprocher ce qu'il réclame des bons
/// réellement émis. GENERATED est l'inverse — l'IPM édite lui-même la facture
/// à partir de la consommation constatée, et il n'y a alors pas d'écart
/// possible puisque les deux chiffres sortent de la même source.
enum IpmInvoiceOrigin {
  RECEIVED
  GENERATED
}

enum IpmProviderInvoiceStatus {
  RECEIVED
  CHECKED
  APPROVED
  PAID
  REJECTED
}

/// Facture prestataire — plan §4.8.
///
/// The bons it covers are attached to it, and `totalAmount` is what the
/// provider claims. The difference between that and the sum of the attached
/// bons is the thing the contrôle exists to find, so both are kept rather
/// than one being derived from the other.
model IpmProviderInvoice {
  id         String @id @default(cuid())
  firmId     String
  providerId String

  number       String
  receivedDate DateTime
  periodFrom   DateTime
  periodTo     DateTime

  /// What the provider claims.
  totalAmount   Decimal @db.Decimal(14, 2)
  /// Sum of the attached bons' insurer shares, computed on attachment.
  matchedAmount Decimal @default(0) @db.Decimal(14, 2)

  status IpmProviderInvoiceStatus @default(RECEIVED)
  origin IpmInvoiceOrigin         @default(RECEIVED)

  checkedById  String?
  checkedAt    DateTime?
  rejectReason String?

  disbursementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm         Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  provider     IpmProvider              @relation(fields: [providerId], references: [id])
  checkedBy    User?                    @relation("IpmProviderInvoiceChecker", fields: [checkedById], references: [id])
  disbursement IpmDisbursement?         @relation(fields: [disbursementId], references: [id])
  lines        IpmProviderInvoiceLine[]

  @@unique([firmId, providerId, number])
  @@index([firmId, status])
  @@map("ipm_provider_invoices")
}

/// Le détail d'une facture prestataire éditée par l'IPM.
///
/// Une ligne par bon réglé sur la période. Tout est **dénormalisé au moment de
/// l'édition** — le numéro du bon, le bénéficiaire, la date, les trois
/// montants — pour la même raison que `IpmVoucher` fige son taux : une facture
/// est un document envoyé à un tiers, et ce qu'il a reçu ne doit pas changer
/// parce qu'un bon a été corrigé ensuite. `voucherId` reste pour remonter au
/// dossier, et passe à NULL si le bon disparaît, sans emporter la ligne.
model IpmProviderInvoiceLine {
  id        String  @id @default(cuid())
  firmId    String
  invoiceId String
  voucherId String?

  voucherNumber   String
  serviceDate     DateTime
  beneficiaryName String
  memberMatricule String
  categoryLabel   String

  totalAmount  Decimal @db.Decimal(12, 2)
  insurerShare Decimal @db.Decimal(12, 2)
  memberShare  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  firm    Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice IpmProviderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  voucher IpmVoucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([firmId, invoiceId])
  @@map("ipm_provider_invoice_lines")
}

enum IpmReimbursementStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  PAID
}

/// Remboursement — the other flow into consumption (§4.7).
///
/// A participant who paid up front and claims it back. It feeds the register
/// and the plafonds exactly as a bon does, which is why `IpmConsumption` was
/// built to accept either source from the start.
model IpmReimbursement {
  id          String  @id @default(cuid())
  firmId      String
  memberId    String
  dependentId String?

  number        String
  submittedDate DateTime
  categoryId    String

  totalAmount  Decimal @db.Decimal(12, 2)
  insurerShare Decimal @db.Decimal(12, 2)
  appliedRate  Decimal @db.Decimal(5, 4)

  status IpmReimbursementStatus @default(SUBMITTED)

  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?

  disbursementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm         Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member       Member             @relation(fields: [memberId], references: [id])
  dependent    Dependent?         @relation(fields: [dependentId], references: [id])
  category     IpmServiceCategory @relation(fields: [categoryId], references: [id])
  reviewedBy   User?              @relation("IpmReimbursementReviewer", fields: [reviewedById], references: [id])
  disbursement IpmDisbursement?   @relation(fields: [disbursementId], references: [id])

  @@unique([firmId, number])
  @@index([firmId, status])
  @@index([firmId, memberId])
  @@map("ipm_reimbursements")
}

enum IpmDisbursementStatus {
  DRAFT
  APPROVED
  POSTED
  PAID
  CANCELLED
}

enum IpmPayeeType {
  PROVIDER
  MEMBER
  SUPPLIER
}

enum IpmPaymentMethod {
  CHEQUE
  TRANSFER
  CASH
  ORANGE_MONEY
}

/// Bon de décaissement — plan §4.9.
///
/// Deliberately generic (`payeeType`, and lines that carry a `sourceType`):
/// the plan says this object is the foundation of a future Finance module and
/// will serve frais généraux and salaries too. It is designed for that and
/// exposed in v1 restricted to the IPM.
///
/// The three visas are three separate facts, each with its own author and
/// timestamp. VISA RÉCEPTION stays manual — it is the payee who signs on
/// collection, and no field here can stand for that.
model IpmDisbursement {
  id     String @id @default(cuid())
  firmId String

  number      String
  date        DateTime
  /// B1 · 02 · OM — the journal the entry lands in.
  journalCode String

  payeeType IpmPayeeType
  payeeId   String?
  payeeName String

  amount Decimal @db.Decimal(14, 2)
  motif  String

  paymentMethod    IpmPaymentMethod
  paymentReference String?

  enteredById String?

  /// VISA DIRECTION
  approvedById   String?
  approvedAt     DateTime?
  /// VISA COMPTABILITÉ
  accountingById String?
  accountingAt   DateTime?
  /// VISA RÉCEPTION — manuscrit, recorded when the payee collects.
  receivedAt     DateTime?

  status IpmDisbursementStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm             Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  enteredBy        User?                 @relation("IpmDisbursementAuthor", fields: [enteredById], references: [id])
  approvedBy       User?                 @relation("IpmDisbursementApprover", fields: [approvedById], references: [id])
  accountingBy     User?                 @relation("IpmDisbursementAccountant", fields: [accountingById], references: [id])
  lines            IpmDisbursementLine[]
  providerInvoices IpmProviderInvoice[]
  reimbursements   IpmReimbursement[]

  @@unique([firmId, number])
  @@index([firmId, status, date])
  @@map("ipm_disbursements")
}

model IpmDisbursementLine {
  id             String @id @default(cuid())
  firmId         String
  disbursementId String

  sourceType String
  sourceId   String?
  label      String
  amount     Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  firm         Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  disbursement IpmDisbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)

  @@index([firmId, disbursementId])
  @@map("ipm_disbursement_lines")
}

// ============================================================================
// IPM — PORTAIL PARTICIPANT
// ============================================================================

enum PortalAccountStatus {
  INVITED
  ACTIVE
  LOCKED
}

enum PortalNotificationKind {
  VOUCHER_APPROVED
  VOUCHER_REJECTED
  /// A bon de pharmacie received its amount (from the pharmacy or the IPM).
  VOUCHER_VALIDATED
  /// The IPM changed the amount of a validated bon.
  VOUCHER_ADJUSTED
  /// The IPM voided a bon.
  VOUCHER_VOIDED
}

/// The participant's login. Deliberately not a User: no UserFirm, no route
/// into the back office. Authenticates against /api/portail with a bearer
/// token, and LOCKED takes effect on the next request.
model PortalAccount {
  id          String              @id @default(cuid())
  firmId      String
  memberId    String              @unique
  /// National format, 9 digits, no spaces, no +221.
  phone       String
  status      PortalAccountStatus @default(INVITED)
  activatedAt DateTime?
  lastLoginAt DateTime?

  /// Set when the participant asks for help from the login screen; cleared
  /// when a gestionnaire issues an access code (or the participant logs in).
  accessRequestedAt   DateTime?
  /// One-time access code issued from the back office, for a participant who
  /// cannot receive the SMS code. HMAC of the code, never the code itself;
  /// single use, and a new one replaces the old.
  accessCodeHash      String?
  accessCodeExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm          Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member        Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  vouchers      IpmVoucher[]
  notifications PortalNotification[]

  @@unique([firmId, phone])
  @@index([firmId, accessRequestedAt])
  @@map("ipm_portal_accounts")
}

/// Review policy for portal bons, one row per IPM.
model IpmPortalSettings {
  firmId                  String   @id
  /// FCFA. Above it (or above the ratio below, whichever is lower) a bon waits.
  reviewThresholdAmount   Decimal  @default(100000) @db.Decimal(12, 2)
  reviewThresholdRatio    Decimal  @default(0.5) @db.Decimal(5, 4)
  unusualAmountMultiple   Decimal  @default(3) @db.Decimal(5, 2)
  ocrMismatchTolerance    Decimal  @default(0.15) @db.Decimal(5, 4)
  /// Days a bon de pharmacie may wait for its amount before it expires.
  pharmacyValidationDays  Int      @default(7)
  /// FCFA. A pharmacy amount above it still validates and counts, flagged
  /// AMOUNT_ABOVE_THRESHOLD. Null: no flag.
  pharmacyReviewThreshold Decimal? @db.Decimal(12, 2)

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("ipm_portal_settings")
}

/// What the portal tells a participant about their bons — written in the same
/// transaction as the review decision it reports.
model PortalNotification {
  id              String                 @id @default(cuid())
  firmId          String
  portalAccountId String
  voucherId       String
  kind            PortalNotificationKind
  createdAt       DateTime               @default(now())
  readAt          DateTime?

  firm          Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  portalAccount PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  voucher       IpmVoucher    @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([portalAccountId, readAt])
  @@map("ipm_portal_notifications")
}

/// What a bon of each type books against when a participant fills it on the
/// portal. In the back office the operator picks the prestation; a participant
/// picks only the kind of bon, so each IPM says here which prestation that
/// means and which provider specialties may receive it.
///
/// Data, not code: a type with no row is simply not offered on the portal, and
/// changing the mapping is an edit, not a deployment.
model IpmPortalBooking {
  id            String                 @id @default(cuid())
  firmId        String
  type          IpmVoucherType
  serviceTypeId String
  /// Empty means any accredited provider may receive this type of bon.
  specialties   IpmProviderSpecialty[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  firm        Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  serviceType IpmServiceType @relation(fields: [serviceTypeId], references: [id])

  @@unique([firmId, type])
  @@map("ipm_portal_bookings")
}

/// Plafonds particuliers — a ceiling set for one participant's family in one
/// category, above whatever the employer and the formule say.
///
/// Ceilings only: the taux stays the employer's or the formule's. Each field is
/// resolved on its own, most specific first — participant, then employer, then
/// formule — so a null here means **inherit**, never "no ceiling".
///
/// Effective-dated like the cotisations: a change closes the open row and opens
/// a new one, so a bon can always be explained by the ceiling in force on its
/// date. At most one open row (validTo null) per member and category; the
/// action enforces it, as Prisma cannot declare a partial unique index.
model IpmMemberCeiling {
  id             String    @id @default(cuid())
  firmId         String
  memberId       String
  categoryId     String
  ceilingPerAct  Decimal?  @db.Decimal(12, 2)
  ceilingMonthly Decimal?  @db.Decimal(12, 2)
  ceilingAnnual  Decimal?  @db.Decimal(12, 2)
  /// Why this family is treated differently. Required: an exception nobody can
  /// explain a year later is one nobody can defend.
  reason         String
  validFrom      DateTime
  validTo        DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  firm      Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category  IpmServiceCategory @relation(fields: [categoryId], references: [id])
  createdBy User?              @relation("IpmMemberCeilingAuthor", fields: [createdById], references: [id])

  @@index([firmId, memberId, categoryId, validFrom])
  @@map("ipm_member_ceilings")
}

// ============================================================================
// IPM — ACCÈS PRESTATAIRE
// ============================================================================

/// The pharmacy's login on the portal: one per provider. Deliberately neither
/// a User (no route into the back office) nor a PortalAccount (no family).
/// Authenticates against /api/portail/prestataire with a bearer token signed
/// by its own secret, and every request re-reads this row — deactivating it,
/// or resetting its password, takes effect on the next call.
model ProviderAccount {
  id                 String    @id @default(cuid())
  firmId             String
  providerId         String    @unique
  /// The code prestataire. Unique across the database, because the login is
  /// code + password with no firm: only one firm runs the module today.
  username           String    @unique
  /// bcrypt, as `User.passwordHash`.
  passwordHash       String
  /// Set by a temporary password (creation or reset); cleared by the change.
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  createdById        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm              Firm                     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  provider          IpmProvider              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdBy         User?                    @relation("ProviderAccountCreator", fields: [createdById], references: [id])
  sessions          ProviderSession[]
  vouchersValidated IpmVoucher[]
  amountChanges     IpmVoucherAmountChange[]

  @@index([firmId])
  @@map("ipm_provider_accounts")
}

/// A provider session. The token carries this row's id; the row is what makes
/// a logout, a password reset or a deactivation revoke it at once. Separate
/// from the back office's `Session` and from the participant's stateless token.
model ProviderSession {
  id         String    @id @default(cuid())
  accountId  String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  account ProviderAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@map("ipm_provider_sessions")
}
