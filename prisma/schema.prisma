generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(cuid())
  name               String?
  email              String                  @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  recordedAbsences   Absence[]
  accounts           Account[]
  auditLogs          AuditLog[]
  generatedReports   ClientQuarterlyReport[]
  dashboards         DashboardView[]
  uploadedDocuments  EmployeeDocument[]      @relation("DocumentUploader")
  verifiedDocuments  EmployeeDocument[]      @relation("DocumentVerifier")
  approvedTransfers  EmployeeTransfer[]      @relation("TransferApprover")
  requestedTransfers EmployeeTransfer[]      @relation("TransferRequester")
  employees          Employee[]
  reviewedLeaves     LeaveRequest[]
  approvedMissions   Mission[]
  approvedPayslips   Payslip[]
  sessions           Session[]
  clientAssignments  UserClientAssignment[]
  userFirms          UserFirm[]
  ipmContributions   IpmMemberContribution[] @relation("IpmContributionAuthor")
  ipmCards           IpmMemberCard[]         @relation("IpmCardAuthor")

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Holding {
  id            String         @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  firms         Firm[]
  persons       Person[]
  organizations Organization[]

  @@map("holdings")
}

model Firm {
  id                    String                  @id @default(cuid())
  holdingId             String
  name                  String
  slug                  String                  @unique
  themeColor            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  logo                  String?
  auditLogs             AuditLog[]
  clientAssignments     ClientFirmAssignment[]
  clientReports         ClientQuarterlyReport[]
  clients               Client[]
  clientFirmContracts   Contract[]              @relation("ClientFirmContracts")
  contracts             Contract[]
  dashboards            DashboardView[]
  departments           Department[]
  transfersOut          EmployeeTransfer[]      @relation("TransfersOut")
  transfersIn           EmployeeTransfer[]      @relation("TransfersIn")
  employees             Employee[]
  firmModules           FirmModule[]
  holding               Holding                 @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  leaveRequests         LeaveRequest[]
  missions              Mission[]
  payrollConfig         PayrollConfig?
  payslips              Payslip[]
  userClientAssignments UserClientAssignment[]
  userFirms             UserFirm[]

  // IPM. Every row is firm-scoped, which is what §7 relies on: the tenancy
  // predicate on these tables is the same one every other resolver applies.
  ipmServiceCategories   IpmServiceCategory[]
  ipmServiceTypes        IpmServiceType[]
  ipmProviderSpecialties IpmProviderSpecialty[]
  ipmMedicalActs         IpmMedicalAct[]
  ipmPlans               IpmPlan[]
  ipmPlanRates           IpmPlanRate[]
  ipmEmployerRates       IpmEmployerRate[]
  ipmEmployers           IpmEmployer[]
  ipmMembers             Member[]
  ipmDependents          Dependent[]
  ipmContributions       IpmMemberContribution[]
  ipmCards               IpmMemberCard[]

  @@map("firms")
}

model UserFirm {
  id        String   @id @default(cuid())
  userId    String
  firmId    String
  role      FirmRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, firmId])
  @@map("user_firms")
}

model Module {
  id           String             @id @default(cuid())
  slug         String             @unique
  name         String
  description  String?
  version      String
  icon         String?
  basePath     String
  isSystem     Boolean            @default(false)
  isActive     Boolean            @default(true)
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  firmModules  FirmModule[]
  requiredBy   ModuleDependency[] @relation("RequiredBy")
  dependencies ModuleDependency[] @relation("ModuleDeps")

  @@map("modules")
}

model FirmModule {
  id          String   @id @default(cuid())
  firmId      String
  moduleId    String
  isEnabled   Boolean  @default(true)
  settings    Json?
  installedAt DateTime @default(now())
  installedBy String?
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([firmId, moduleId])
  @@map("firm_modules")
}

model ModuleDependency {
  id          String @id @default(cuid())
  moduleId    String
  dependsOnId String
  dependsOn   Module @relation("RequiredBy", fields: [dependsOnId], references: [id], onDelete: Cascade)
  module      Module @relation("ModuleDeps", fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, dependsOnId])
  @@map("module_dependencies")
}

model Department {
  id        String     @id @default(cuid())
  firmId    String
  name      String
  code      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  managerId String?
  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[] @relation("DepartmentEmployees")

  @@unique([firmId, code])
  @@map("departments")
}

model Employee {
  id                 String             @id @default(cuid())
  firmId             String
  userId             String?
  firstName          String
  lastName           String
  matricule          String
  departmentId       String?
  status             EmployeeStatus     @default(ACTIVE)
  hireDate           DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  address            String?
  assignedClientId   String?
  email              String?
  emergencyContact   Json?
  phone              String?
  category           String?
  cni                String?
  contractEndDate    DateTime?
  dateOfBirth        DateTime?
  fatherName         String?
  gender             Gender?
  jobTitle           String?
  maritalStatus      String?
  motherName         String?
  nationality        String?
  netSalary          Decimal?           @db.Decimal(10, 2)
  photoUrl           String?
  placeOfBirth       String?
  /// Shared identity (§4.1). Nullable: this is a link, not the Employment
  /// split — no HR query reads it yet, and rows predating the seed have none.
  personId           String?
  absences           Absence[]
  contracts          Contract[]
  managedDepartments Department[]       @relation("DepartmentManager")
  documents          EmployeeDocument[]
  salaries           EmployeeSalary[]
  transfersOut       EmployeeTransfer[] @relation("TransferFrom")
  assignedClient     Client?            @relation(fields: [assignedClientId], references: [id])
  department         Department?        @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  firm               Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id])
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  requestedMissions  Mission[]
  payslips           Payslip[]
  person             Person?            @relation(fields: [personId], references: [id])
  ipmMembers         Member[]

  @@unique([firmId, matricule])
  @@index([personId])
  @@map("employees")
}

model Contract {
  id                 String            @id @default(cuid())
  firmId             String
  employeeId         String
  type               ContractType
  startDate          DateTime
  endDate            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  alertThreshold     Int               @default(30)
  clientId           String?
  isActive           Boolean           @default(true)
  isAutoRenewal      Boolean           @default(false)
  notes              String?
  position           String?
  renewalDate        DateTime?
  salary             Decimal?          @db.Decimal(10, 2)
  terminationDate    DateTime?
  terminationReason  String?
  trialPeriodEnd     DateTime?
  workingHours       Int?
  clientFirmId       String?
  renewedFromId      String?
  status             ContractStatus    @default(ACTIVE)
  isVise             Boolean           @default(false)
  contractDocumentId String?
  clientFirm         Firm?             @relation("ClientFirmContracts", fields: [clientFirmId], references: [id])
  client             Client?           @relation(fields: [clientId], references: [id])
  contractDocument   EmployeeDocument? @relation("ContractSignedDocument", fields: [contractDocumentId], references: [id])
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  firm               Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  renewedFrom        Contract?         @relation("ContractRenewal", fields: [renewedFromId], references: [id])
  renewals           Contract[]        @relation("ContractRenewal")

  @@index([contractDocumentId])
  @@map("contracts")
}

model EmployeeTransfer {
  id              String         @id @default(cuid())
  employeeId      String
  fromFirmId      String
  toFirmId        String
  clientId        String?
  transferDate    DateTime
  effectiveDate   DateTime
  reason          String
  status          TransferStatus @default(PENDING)
  requestedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  newMatricule    String?
  approver        User?          @relation("TransferApprover", fields: [approvedBy], references: [id])
  client          Client?        @relation(fields: [clientId], references: [id])
  employee        Employee       @relation("TransferFrom", fields: [employeeId], references: [id])
  fromFirm        Firm           @relation("TransfersOut", fields: [fromFirmId], references: [id])
  requester       User           @relation("TransferRequester", fields: [requestedBy], references: [id])
  toFirm          Firm           @relation("TransfersIn", fields: [toFirmId], references: [id])

  @@map("employee_transfers")
}

model LeaveRequest {
  id              String      @id @default(cuid())
  firmId          String
  employeeId      String
  startDate       DateTime
  endDate         DateTime
  status          LeaveStatus @default(PENDING)
  reason          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isJustified     Boolean     @default(false)
  isPaid          Boolean     @default(true)
  justification   String?
  leaveType       LeaveType
  rejectionReason String?
  requestedAt     DateTime    @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  supportingDoc   String?
  totalDays       Decimal     @db.Decimal(5, 2)
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  firm            Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  reviewer        User?       @relation(fields: [reviewedBy], references: [id])

  @@map("leave_requests")
}

model LeaveBalance {
  id            String    @id @default(cuid())
  employeeId    String
  year          Int
  leaveType     LeaveType
  totalDays     Decimal   @db.Decimal(5, 2)
  usedDays      Decimal   @default(0) @db.Decimal(5, 2)
  remainingDays Decimal   @db.Decimal(5, 2)
  carriedOver   Decimal   @default(0) @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, leaveType])
  @@map("leave_balances")
}

model Absence {
  id            String      @id @default(cuid())
  employeeId    String
  firmId        String
  absenceType   AbsenceType
  date          DateTime
  startTime     DateTime?
  endTime       DateTime?
  hours         Decimal?    @db.Decimal(5, 2)
  isJustified   Boolean     @default(false)
  justification String?
  supportingDoc String?
  recordedBy    String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recorder      User        @relation(fields: [recordedBy], references: [id])

  @@map("absences")
}

model Mission {
  id              String           @id @default(cuid())
  firmId          String
  requesterId     String
  title           String
  destination     String
  startDate       DateTime
  endDate         DateTime
  status          MissionStatus    @default(DRAFT)
  purpose         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  actualAmount    Decimal?         @db.Decimal(10, 2)
  approvedAt      DateTime?
  approvedBy      String?
  budgetAmount    Decimal?         @db.Decimal(10, 2)
  completedAt     DateTime?
  missionFees     Decimal?         @db.Decimal(10, 2)
  rejectionReason String?
  report          String?
  expenses        MissionExpense[]
  approver        User?            @relation(fields: [approvedBy], references: [id])
  firm            Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  requester       Employee         @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("missions")
}

model MissionExpense {
  id          String          @id @default(cuid())
  missionId   String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  description String?
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  mission     Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("mission_expenses")
}

model PayrollConfig {
  id        String   @id @default(cuid())
  firmId    String   @unique
  constants Json
  formulas  Json?
  currency  String   @default("XOF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("payroll_configs")
}

model EmployeeSalary {
  id            String    @id @default(cuid())
  employeeId    String
  baseSalary    Decimal   @db.Decimal(10, 2)
  variables     Json?
  effectiveDate DateTime
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslips      Payslip[]

  @@map("employee_salaries")
}

model Payslip {
  id              String         @id @default(cuid())
  firmId          String
  employeeId      String
  salaryId        String
  period          String
  grossSalary     Decimal        @db.Decimal(10, 2)
  netSalary       Decimal        @db.Decimal(10, 2)
  deductions      Json
  additions       Json
  calculationData Json
  status          PayslipStatus  @default(DRAFT)
  generatedAt     DateTime       @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approver        User?          @relation(fields: [approvedBy], references: [id])
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  firm            Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  salary          EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
  @@map("payslips")
}

model Client {
  id                String                  @id @default(cuid())
  firmId            String
  name              String
  contactName       String?
  taxNumber         String?
  address           String?
  tags              String[]
  status            ClientStatus            @default(PROSPECT)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  contactEmail      String?
  contactPhone      String?
  contractEndDate   DateTime?
  contractStartDate DateTime?
  industry          String?
  notes             String?
  photoUrl          String?
  /// Shared identity (§4.1). A client and an IPM employer can be the same
  /// company; nullable because no CRM query reads it yet.
  organizationId    String?
  firmAssignments   ClientFirmAssignment[]
  quarterlyReports  ClientQuarterlyReport[]
  firm              Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  contracts         Contract[]
  transfers         EmployeeTransfer[]
  assignedEmployees Employee[]
  userAssignments   UserClientAssignment[]
  organization      Organization?           @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("clients")
}

model UserClientAssignment {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  firmId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId, firmId])
  @@map("user_client_assignments")
}

model ClientFirmAssignment {
  id        String    @id @default(cuid())
  clientId  String
  firmId    String
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm      Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([clientId, firmId])
  @@map("client_firm_assignments")
}

model ClientQuarterlyReport {
  id            String    @id @default(cuid())
  firmId        String
  clientId      String
  quarter       String
  year          Int
  quarterNumber Int
  employeeCount Int
  totalHours    Decimal?  @db.Decimal(10, 2)
  totalCost     Decimal?  @db.Decimal(10, 2)
  reportData    Json
  generatedAt   DateTime  @default(now())
  generatedBy   String
  pdfUrl        String?
  excelUrl      String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm          Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  generator     User      @relation(fields: [generatedBy], references: [id])

  @@unique([clientId, quarter])
  @@map("client_quarterly_reports")
}

model EmployeeDocument {
  id              String       @id @default(cuid())
  employeeId      String
  firmId          String
  documentType    DocumentType
  fileName        String
  storageKey      String
  fileUrl         String?
  fileSize        Int?
  mimeType        String?
  uploadedBy      String
  description     String?
  expiryDate      DateTime?
  isVerified      Boolean      @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  metadata        Json?
  tags            String[]     @default([])
  signedContracts Contract[]   @relation("ContractSignedDocument")
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploader        User         @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  verifier        User?        @relation("DocumentVerifier", fields: [verifiedBy], references: [id])

  @@map("employee_documents")
}

model DashboardView {
  id        String   @id @default(cuid())
  firmId    String
  userId    String
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboard_views")
}

model AuditLog {
  id        String   @id @default(cuid())
  firmId    String?
  actorId   String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  firm      Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

enum FirmRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
  RESPONSABLE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
  ON_LEAVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ContractType {
  CDI
  CDD
  STAGE
  PRESTATION
  INTERIM
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  SPECIAL
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AbsenceType {
  UNJUSTIFIED
  JUSTIFIED
  LATE_ARRIVAL
  EARLY_DEPARTURE
}

enum MissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  IN_PROGRESS
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  MEALS
  FUEL
  OTHER
}

enum PayslipStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ARCHIVED
}

enum DocumentType {
  CV
  ID_CARD
  PASSPORT
  CONTRACT
  PAYSLIP
  CERTIFICATE
  DIPLOMA
  MEDICAL_CERTIFICATE
  LEGAL_DOCUMENT
  MISSION_REPORT
  EXPENSE_RECEIPT
  OTHER
}

enum FileEntity {
  EMPLOYEE
  CLIENT
  CONTRACT
  MISSION
  LEAVE_REQUEST
  CLAIM
}

// ============================================================================
// SHARED IDENTITY — HOLDING LEVEL
// ============================================================================
// Plan §4.1. A person may be simultaneously an employee of Connect Interim and
// an IPM participant; a company may be a CRM client, an employer of interims
// and an IPM employer. Identity therefore lives above the firm, and the
// firm-scoped records point at it.
//
// This does **not** rewrite Employee or Client onto Person/Organization — that
// is the Employment split the plan lists as Phase 0 socle, and it touches every
// HR query. The links below are nullable so identity can be established
// incrementally; the IPM side uses them as the source of truth from day one.

model Person {
  id         String    @id @default(cuid())
  holdingId  String
  firstName  String
  lastName   String
  birthDate  DateTime?
  birthPlace String?
  gender     Gender?
  /// CNI sénégalaise.
  nationalId String?
  passportNo String?
  phone      String?
  email      String?
  address    String?
  /// Zipline URL, same convention as Employee.photoUrl.
  photoUrl   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  holding    Holding     @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  employees  Employee[]
  members    Member[]
  dependents Dependent[]

  // Postgres treats NULLs as distinct, so people without a CNI do not collide.
  @@unique([holdingId, nationalId])
  @@index([holdingId, lastName, firstName])
  @@map("persons")
}

model Organization {
  id        String   @id @default(cuid())
  holdingId String
  /// Raison sociale.
  name      String
  ninea     String?
  sector    String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holding   Holding       @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  clients   Client[]
  employers IpmEmployer[]

  @@unique([holdingId, ninea])
  @@index([holdingId, name])
  @@map("organizations")
}

// ============================================================================
// IPM — RÉFÉRENTIELS
// ============================================================================

/// Catégorie de soins. A **table, not an enum** (§11 Q3).
///
/// Asked whether accouchement should be priced separately, the answer was that
/// plan options must stay configurable — so categories, rates, ceilings and
/// waiting periods are data an administrator edits, never an enum that needs a
/// deploy. Adding MATERNITE is a row, not a migration.
model IpmServiceCategory {
  id        String   @id @default(cuid())
  firmId    String
  code      String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm          Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  serviceTypes  IpmServiceType[]
  planRates     IpmPlanRate[]
  employerRates IpmEmployerRate[]

  @@unique([firmId, code])
  @@map("ipm_service_categories")
}

/// Type de prestation — WebLamps codes 0-49, SYSCOHADA 602xxx.
model IpmServiceType {
  id          String   @id @default(cuid())
  firmId      String
  categoryId  String
  code        String
  label       String
  /// Compte SYSCOHADA 602xxx. Not renumbered — see plan §3.
  accountCode String?
  legacyCode  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm        Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  category    IpmServiceCategory @relation(fields: [categoryId], references: [id])
  medicalActs IpmMedicalAct[]

  @@unique([firmId, code])
  @@index([firmId, categoryId])
  @@map("ipm_service_types")
}

/// Spécialité prestataire — codes 0-99, SYSCOHADA 400xxx.
model IpmProviderSpecialty {
  id          String   @id @default(cuid())
  firmId      String
  code        String
  label       String
  accountCode String?
  legacyCode  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, code])
  @@map("ipm_provider_specialties")
}

model IpmMedicalAct {
  id            String   @id @default(cuid())
  firmId        String
  serviceTypeId String
  code          String
  label         String
  coefficient   Decimal? @db.Decimal(8, 2)
  tariff        Decimal? @db.Decimal(12, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firm        Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  serviceType IpmServiceType @relation(fields: [serviceTypeId], references: [id])

  @@unique([firmId, code])
  @@index([firmId, serviceTypeId])
  @@map("ipm_medical_acts")
}

// ============================================================================
// IPM — FORMULES ET BARÈMES
// ============================================================================

/// Who a rate applies to.
///
/// `ALL` is a real member rather than a nullable column on purpose: a nullable
/// discriminator cannot be covered by a unique constraint in Postgres, where
/// NULLs are distinct — two "applies to everyone" rows for the same category
/// would both be accepted. Resolution tries the exact type, then ALL.
///
/// The numbers are the WebLamps `codebenef` values, kept for the import. The
/// participant carries 1; `lienjuridique` is not used (229 CJ for 95 real
/// spouses — see plan §4.2).
enum IpmBeneficiaryType {
  ALL
  MEMBER // 1
  SPOUSE_F // 2
  CHILD // 3
  SPOUSE_M // 4
  ASCENDANT // 5
  OTHER // 6
}

/// Formule commerciale (Tawfeikh / Xeweul / Teranga / Noflay).
///
/// Effective-dated: a voucher issued in January must still price against
/// January's formule after a March change, so a price is never updated in
/// place. `validTo` NULL means currently in force.
model IpmPlan {
  id           String    @id @default(cuid())
  firmId       String
  code         String
  name         String
  monthlyPrice Decimal   @db.Decimal(12, 2)
  validFrom    DateTime
  validTo      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  firm          Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  rates         IpmPlanRate[]
  employers     IpmEmployer[]
  contributions IpmMemberContribution[]

  @@unique([firmId, code, validFrom])
  @@index([firmId, active])
  @@map("ipm_plans")
}

/// Barème — taux de prise en charge et plafonds.
///
/// `rate` is a fraction, not a percentage: the settlement engine computes
/// `insurerShare = ceil(totalAmount × rate)` directly, and a stray ×100 in that
/// line is the kind of error that is invisible until money moves. The interface
/// renders it as a percentage; the column never holds one.
model IpmPlanRate {
  id                String             @id @default(cuid())
  firmId            String
  planId            String
  categoryId        String
  beneficiaryType   IpmBeneficiaryType @default(ALL)
  rate              Decimal            @db.Decimal(5, 4)
  ceilingPerAct     Decimal?           @db.Decimal(12, 2)
  ceilingMonthly    Decimal?           @db.Decimal(12, 2)
  ceilingAnnual     Decimal?           @db.Decimal(12, 2)
  /// Délai de carence, en jours. Distinct des plafonds (plan §4.3).
  waitingPeriodDays Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  firm     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  plan     IpmPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  category IpmServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([planId, categoryId, beneficiaryType])
  @@map("ipm_plan_rates")
}

/// Dérogation par employeur. Wins over the formule's own barème.
///
/// The 20 current employers apply a single rate (50, 70 or 80%) and are
/// migrated here, then moved onto a formule when the IPM decides.
model IpmEmployerRate {
  id                String             @id @default(cuid())
  firmId            String
  employerId        String
  categoryId        String
  beneficiaryType   IpmBeneficiaryType @default(ALL)
  rate              Decimal            @db.Decimal(5, 4)
  ceilingPerAct     Decimal?           @db.Decimal(12, 2)
  ceilingMonthly    Decimal?           @db.Decimal(12, 2)
  ceilingAnnual     Decimal?           @db.Decimal(12, 2)
  waitingPeriodDays Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  firm     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  employer IpmEmployer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category IpmServiceCategory @relation(fields: [categoryId], references: [id])

  @@unique([employerId, categoryId, beneficiaryType])
  @@map("ipm_employer_rates")
}

// ============================================================================
// IPM — AFFILIATION
// ============================================================================

enum IpmEmployerStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum IpmMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum IpmDependentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// Ayant droit. WebLamps `codebenef`; `lienjuridique` is deliberately ignored.
enum IpmDependentRelation {
  SPOUSE_F // 2
  CHILD // 3
  SPOUSE_M // 4
  ASCENDANT // 5
  OTHER // 6
}

model IpmEmployer {
  id                 String            @id @default(cuid())
  firmId             String
  organizationId     String
  legacyCode         String?
  /// The `001` of a WebLamps `001-00185-21`. Kept so a legacy matricule can be
  /// rebuilt and reconciled; it does not number anything new.
  legacyEmployerCode String?
  /// Optional prefix for generated member matricules.
  ///
  /// NULL — the normal case — puts the employer's members on the firm-wide
  /// five-digit sequence the cards carry (`01716`, §11 Q1). A prefix exists
  /// only for an employer that later wants a series of its own, and is not
  /// unique: several employers sharing the card sequence all have none.
  matriculePrefix    String?
  planId             String?
  /// Compte SYSCOHADA 463xxx. Two legacy formats, normalised on import.
  accountCode        String?
  affiliationDate    DateTime
  terminationDate    DateTime?
  status             IpmEmployerStatus @default(ACTIVE)

  /// Âge auquel un enfant cesse d'être couvert. 21 ou 22 selon l'employeur.
  ageMajority   Int @default(21)
  ageRetirement Int @default(60)

  /// Defaults inherited by a new member's first contribution row.
  contributionEmployerAmount Decimal? @db.Decimal(12, 2)
  contributionEmployeeAmount Decimal? @db.Decimal(12, 2)
  contributionRate           Decimal? @db.Decimal(5, 4)

  reminderDelayDays   Int      @default(15)
  suspensionDelayDays Int      @default(90)
  /// `seuil_conso` 1e8–1e12 in the legacy data is imported as NULL = illimité.
  consumptionCeiling  Decimal? @db.Decimal(14, 2)
  debtCeiling         Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm         Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id])
  plan         IpmPlan?          @relation(fields: [planId], references: [id])
  members      Member[]
  rates        IpmEmployerRate[]

  @@unique([firmId, organizationId])
  @@unique([firmId, legacyEmployerCode])
  @@unique([firmId, legacyCode])
  @@index([firmId, status])
  @@map("ipm_employers")
}

model Member {
  id         String  @id @default(cuid())
  firmId     String
  personId   String
  employerId String
  /// Link to the employment that drives the affiliation (§7). Nullable: the IPM
  /// also covers employers outside the group, who have no Employee row here.
  employeeId String?

  /// Canonical matricule — the short form printed on the cards (`01716`).
  /// §11 Q1. `legacyCode` keeps the WebLamps `001-00185-21` so the two forms
  /// stay cross-referenceable at the counter.
  matricule  String
  legacyCode String?

  jobTitle        String?
  affiliationDate DateTime
  terminationDate DateTime?
  status          IpmMemberStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm          Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  person        Person                  @relation(fields: [personId], references: [id])
  employer      IpmEmployer             @relation(fields: [employerId], references: [id])
  employee      Employee?               @relation(fields: [employeeId], references: [id])
  dependents    Dependent[]
  contributions IpmMemberContribution[]
  card          IpmMemberCard?

  @@unique([firmId, matricule])
  @@unique([firmId, legacyCode])
  @@index([firmId, employerId, status])
  @@index([firmId, personId])
  @@map("ipm_members")
}

model Dependent {
  id       String @id @default(cuid())
  firmId   String
  memberId String
  personId String

  matricule    String
  legacyCode   String?
  relation     IpmDependentRelation
  /// Position within the member's family, 1-based. Drives the card's verso.
  rank         Int
  marriageDate DateTime?

  coverageStart DateTime
  coverageEnd   DateTime?
  status        IpmDependentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id])

  @@unique([firmId, matricule])
  @@unique([memberId, rank])
  @@index([firmId, memberId, status])
  @@map("ipm_dependents")
}

/// Cotisation du participant — effective-dated rows, never a mutable column.
///
/// §11 Q6: the contribution is a fixed amount, and an upgrade must not lose the
/// previous one. A single `monthlyContribution` column cannot satisfy both — an
/// UPDATE erases exactly the history being asked for — so each change closes the
/// current row and opens a new one. A January voucher prices against January's
/// amount even after a March upgrade.
///
/// §11 Q12: one contribution per family. The amount covers the participant and
/// their ayants droit, not one per covered head.
///
/// `validTo` NULL means currently in force; exactly one such row per member.
model IpmMemberContribution {
  id       String  @id @default(cuid())
  firmId   String
  memberId String
  /// The formule this amount was priced against, when there is one.
  planId   String?

  monthlyAmount  Decimal  @db.Decimal(12, 2)
  employerAmount Decimal? @db.Decimal(12, 2)
  employeeAmount Decimal? @db.Decimal(12, 2)

  validFrom DateTime
  validTo   DateTime?
  /// Why it changed — an upgrade, a correction, a renegotiation.
  reason    String?

  createdAt   DateTime @default(now())
  createdById String?

  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan      IpmPlan? @relation(fields: [planId], references: [id])
  createdBy User?    @relation("IpmContributionAuthor", fields: [createdById], references: [id])

  @@index([firmId, memberId, validFrom])
  @@map("ipm_member_contributions")
}

/// Carte de tiers payant — plan §4.10 et §6.
///
/// The row records *that* a card exists and what it was generated from; the
/// image itself is rendered on demand through an authenticated route rather
/// than stored. Storing the bytes buys nothing while a card can be redrawn in
/// milliseconds, and it would immediately create the problem the plan warns
/// about elsewhere: a file on disk that no longer matches the data.
///
/// `inputsHash` is what makes staleness computable. It digests exactly the
/// fields printed on the card, so adding an ayant droit, correcting a name,
/// changing a formule or a child reaching majority all change it — and the
/// dashboard can count cards whose hash no longer matches without rendering
/// anything.
///
/// `revokedAt` is radiation: the card stops verifying, and the row stays as
/// the record that it once did.
model IpmMemberCard {
  id            String    @id @default(cuid())
  firmId        String
  memberId      String
  /// Incremented on every regeneration, and printed on the card.
  version       Int       @default(1)
  inputsHash    String
  ppi           Int       @default(300)
  generatedAt   DateTime  @default(now())
  generatedById String?
  revokedAt     DateTime?

  firm        Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  generatedBy User?  @relation("IpmCardAuthor", fields: [generatedById], references: [id])

  @@unique([memberId])
  @@index([firmId, inputsHash])
  @@map("ipm_member_cards")
}
