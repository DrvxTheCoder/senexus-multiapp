  APPROVED
  PAID
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ARCHIVED
}

enum DocumentType {
  CV
  ID_CARD
  PASSPORT
  CONTRACT
  PAYSLIP
  CERTIFICATE
  DIPLOMA
  MEDICAL_CERTIFICATE
  LEGAL_DOCUMENT
