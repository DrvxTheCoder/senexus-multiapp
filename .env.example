# ---------------------------------------------------------------------------
# Database
#
# The schema is frozen and no migration is ever run from this project.
# Point this at the existing Senexus database; `prisma generate` is enough.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/senexusdb"

# ---------------------------------------------------------------------------
# Auth.js v5
#
# AUTH_SECRET is the v5 name; NEXTAUTH_SECRET is still read as a fallback so an
# existing deployment keeps working. Generate with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage (Zipline)
#
# Uploaded files are served through /api/files/[documentId] behind
# requireFirmAccess. The stored URL stays in the database; it is never rendered
# into HTML.
# ---------------------------------------------------------------------------
ZIPLINE_URL="https://zipline.example.com"
ZIPLINE_TOKEN="replace-me"

# ---------------------------------------------------------------------------
# Participant portal (ipm-portal) — /api/portail/*
#
# PORTAL_TOKEN_SECRET signs the participants' bearer tokens (30 days). At least
#   32 characters; changing it signs every participant out. Unset, the API
#   answers 503. Generate with: openssl rand -base64 48
# PORTAL_ORIGIN is the one origin allowed to call the API from a browser
#   (CORS), e.g. the portal's own URL. Unset, no browser origin is allowed.
# DEMO_OTP is the one-time code every demo account signs in with — there is no
#   SMS yet. Unset, sign-in answers 503; there is no built-in fallback.
# ---------------------------------------------------------------------------
PORTAL_TOKEN_SECRET="replace-me-with-at-least-32-characters"
PORTAL_ORIGIN="http://localhost:3001"
DEMO_OTP=""

# ---------------------------------------------------------------------------
# Provider (pharmacy) access — /api/portail/prestataire/*
#
# PROVIDER_TOKEN_SECRET signs the pharmacies' session tokens. Its own secret,
#   never PORTAL_TOKEN_SECRET's: a participant token must not verify on a
#   provider route. At least 32 characters; unset, the routes answer 503.
# CRON_SECRET guards POST /api/cron/expire-vouchers (Authorization: Bearer …),
#   which marks unvalidated bons de pharmacie EXPIRED. Run it hourly from the
#   host's scheduler. Unset, the route answers 503.
# ---------------------------------------------------------------------------
PROVIDER_TOKEN_SECRET="replace-me-with-at-least-32-characters"
CRON_SECRET=""
